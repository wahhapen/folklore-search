{
  "name": "folklore-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "corpus:fetch": "node scripts/fetch-corpus-release.mjs",
    "corpus:status": "node scripts/corpus-release-status.mjs",
    "corpus:verify": "node scripts/verify-corpus-release.mjs",
    "search": "node scripts/search-corpus.mjs",
    "benchmark": "node scripts/run-search-benchmark.mjs",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 tests/gateway-types.test-d.ts",
    "test": "vitest run",
    "validate": "npm run corpus:verify && npm run benchmark && npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "tar": "7.5.22"
  }
}
